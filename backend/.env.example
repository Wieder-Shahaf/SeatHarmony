# Backend Environment Variables

# Groq API Key (Required)
# Free tier API key for Llama 3.3 70B - fast inference
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Gurobi Web License Service (Required)
# Required for optimization solver
# Get credentials at: https://www.gurobi.com/academia/ (free for academics)
WLSACCESSID=your_wls_access_id_here
WLSSECRET=your_wls_secret_here
LICENSEID=your_license_id_here
